{
  "name": "zapr-cli",
  "version": "1.1.0",
  "description": "Blazing fast node_modules and build output cleaner CLI tool",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "zapr": "./bin/zapr.mjs",
    "zapr-cli": "./bin/zapr.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "oxlint src/",
    "format": "prettier --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "cli",
    "cleanr",
    "node_modules",
    "cleaner",
    "purge",
    "disk-space",
    "build-cleaner"
  ],
  "author": "Bineet Naidu",
  "license": "Blue-Oak-1.0.0",
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  }
}
